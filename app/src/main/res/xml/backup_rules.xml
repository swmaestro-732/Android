<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- 세션 토큰은 Keystore 키로 암호화돼 있고 그 키는 백업되지 않는다. 암호문만 복원되면
         복호화가 불가능해 재로그인만 유발하므로 애초에 백업 대상에서 제외한다. -->
    <exclude domain="file" path="datastore/secure_session.preferences_pb" />
    <!-- Naver SDK 의 암호화 prefs 도 같은 이유로 제외한다. 암호문만 복원되고 Keystore 마스터 키가
         없으면 SDK 가 앱 시작 시 KeyStoreException 으로 크래시할 수 있다(SCRUM-627). -->
    <exclude domain="sharedpref" path="NaverOAuthLoginEncryptedPreferenceData.xml" />
</full-backup-content>
