# CD — Android 배포 자동화.
# build: 서명된 release 아티팩트(AAB/APK) 빌드. GitHub pre-release 용.
# deploy: Play Console 에 AAB 업로드 + 프로덕션 심사 제출. versionCode 는 Play 최신 +1 로 자동.
default_platform(:android)

platform :android do
  desc "서명된 release AAB + APK 빌드 (아티팩트 생성)"
  lane :build do
    gradle(task: "clean")
    # AAB — Play 업로드 표준 포맷
    gradle(task: "bundle", build_type: "Release")
    # APK — 직접 설치/확인용
    gradle(task: "assemble", build_type: "Release")
  end

  desc "Play Console 프로덕션 트랙에 업로드하고 심사를 제출한다"
  lane :deploy do
    # Play 는 versionCode 중복을 거부한다. 모든 주요 트랙에서 현재 최고값을 조회해 +1 을 쓴다
    # — 한 트랙만 보면 다른 트랙에 더 높은 값이 있을 때 충돌한다.
    existing =
      %w[production beta alpha internal].flat_map do |track|
        google_play_track_version_codes(track: track)
      rescue StandardError
        # 아직 아무것도 올라가지 않은 트랙은 조회가 실패할 수 있다. 그 트랙은 건너뛴다.
        []
      end
    next_code = (existing.max || 0) + 1
    UI.message("다음 versionCode = #{next_code} (기존 최고값 #{existing.max || '없음'})")

    # versionName 패치 자동 산정. versionCode 12 == 1.2.0 기준으로, 이후 배포마다 패치를 +1 한다
    # (versionCode 13 → 1.2.1, 14 → 1.2.2 …). 메이저·마이너(1.2)는 build.gradle 에서 관리하며,
    # 거기서 올릴 땐 아래 PATCH_BASE_CODE 를 그 시점 versionCode 로 맞춰 패치를 0 부터 다시 시작시킨다.
    patch_base_code = 12
    version_patch = [next_code - patch_base_code, 0].max
    UI.message("versionName = 1.2.#{version_patch} (patch 자동 산정)")

    # 산정한 versionCode·패치로 서명된 AAB(Play)·APK(GitHub pre-release)를 새로 빌드한다
    # — 두 아티팩트가 같은 버전을 갖도록 한 번에 만든다(기본값 대신 주입값 사용).
    build_props = { "appVersionCode" => next_code, "appVersionPatch" => version_patch }
    gradle(task: "clean")
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: build_props,
    )
    gradle(
      task: "assemble",
      build_type: "Release",
      properties: build_props,
    )

    # 프로덕션 트랙에 올리고 바로 심사 제출(completed). 스토어 등록정보(제목·설명)·스크린샷은
    # Play Console 에서 관리하므로 덮어쓰지 않는다(skip_upload_metadata/images/screenshots).
    # 단 출시 노트(changelogs)는 올린다 — fastlane/metadata/android/<lang>/changelogs/ 에서 읽는다.
    # versionCode 별 파일(<code>.txt)이 없으면 default.txt 를 이 버전의 "새로운 기능"으로 쓴다.
    # skip_upload_metadata 는 등록정보만 막고 changelogs 는 별개라, changelogs 는 그대로 올라간다.
    upload_to_play_store(
      track: "production",
      release_status: "completed",
      aab: "app/build/outputs/bundle/release/app-release.aab",
      metadata_path: "./fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: false,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # ───────────────────────────────────────────────────────────────────────────
  # 소프트 업데이트 안내용 Remote Config 게시.
  # 앱(RemoteConfigAppVersionRepository)은 latest_version_code > 설치본 versionCode 이면
  # 업데이트 안내를 띄운다. 이 lane 이 그 두 값(latest_version_code/latest_version_name)을
  # Firebase Remote Config 에 올린다.
  #
  # ⚠️ 타이밍: 새 버전이 Play 에서 실제로 "라이브"된 뒤 실행할 것. 아직 심사 중인 버전으로
  #   올리면 사용자가 받을 수 없는 버전으로 업데이트 안내가 뜬다. 그래서 deploy 와 분리된
  #   수동 트리거(.github/workflows/remote-config.yml, workflow_dispatch)로 돌린다.
  #
  # 🔑 인증(둘 중 하나):
  #   FIREBASE_JSON_KEY_FILE : Remote Config 수정 권한이 있는 Firebase 서비스계정 JSON 경로.
  #                            CD 는 secret FIREBASE_SERVICE_ACCOUNT_JSON 을 파일로 복원해 넘긴다.
  #   없으면 PLAY_JSON_KEY_FILE 로 폴백한다 — Play SA 에 Remote Config 권한을 준 경우에만 동작.
  #   FIREBASE_PROJECT_ID : 미설정 시 courmy-qa732.
  #
  # 인자(선택): version_code, version_name. 주지 않으면 Play 프로덕션 트랙의 최고 versionCode 로
  #   산정한다. 단 그 값에는 심사 중(미출시) 릴리스가 포함될 수 있으니, 정확히 하려면
  #   라이브된 versionCode 를 version_code 로 직접 넘기는 것을 권장한다.
  desc "출시 버전으로 Remote Config(latest_version_code/name)를 게시한다"
  lane :bump_remote_config do |options|
    project_id = ENV["FIREBASE_PROJECT_ID"].to_s.strip
    project_id = "courmy-qa732" if project_id.empty?

    version_code =
      if options[:version_code]
        options[:version_code].to_i
      else
        codes = google_play_track_version_codes(track: "production")
        UI.user_error!("Play 프로덕션 트랙에서 versionCode 를 찾지 못했습니다.") if codes.nil? || codes.empty?
        codes.max
      end
    UI.user_error!("version_code 가 올바르지 않습니다: #{version_code}") unless version_code.to_i > 0

    version_name =
      if options[:version_name]
        options[:version_name].to_s.strip
      else
        # deploy lane 과 같은 규칙: versionCode 12 == 1.2.0, 이후 +1 마다 패치 +1.
        patch_base_code = 12
        "1.2.#{[version_code.to_i - patch_base_code, 0].max}"
      end

    key_file = ENV["FIREBASE_JSON_KEY_FILE"].to_s.strip
    key_file = ENV["PLAY_JSON_KEY_FILE"].to_s.strip if key_file.empty?
    if key_file.empty? || !File.exist?(key_file)
      UI.user_error!(
        "Remote Config 서비스계정 키가 없습니다. Firebase 콘솔에서 Remote Config 수정 권한이 있는 " \
        "서비스계정 JSON 을 받아 secret FIREBASE_SERVICE_ACCOUNT_JSON 으로 등록하세요 " \
        "(또는 Play SA 에 Remote Config 권한 부여 후 PLAY_JSON_KEY_FILE 사용).",
      )
    end

    publish_remote_config(project_id, key_file, version_code.to_i, version_name)
    UI.success("Remote Config 게시 완료: latest_version_code=#{version_code}, latest_version_name=#{version_name}")
  end
end

# Remote Config REST 게시 헬퍼. 현재 템플릿을 GET(ETag 확보)해서 두 파라미터만 덮어쓰고
# If-Match 로 PUT 한다. 조건부 값·다른 파라미터는 그대로 보존한다.
# googleauth 는 fastlane 의존성으로 이미 설치돼 있어 별도 gem 추가가 필요 없다.
def publish_remote_config(project_id, key_file, version_code, version_name)
  require "googleauth"
  require "net/http"
  require "json"

  authorizer = Google::Auth::ServiceAccountCredentials.make_creds(
    json_key_io: File.open(key_file),
    scope: "https://www.googleapis.com/auth/firebase.remoteconfig",
  )
  token = authorizer.fetch_access_token!["access_token"]

  uri = URI("https://firebaseremoteconfig.googleapis.com/v1/projects/#{project_id}/remoteConfig")
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = true

  get = Net::HTTP::Get.new(uri)
  get["Authorization"] = "Bearer #{token}"
  get_resp = http.request(get)
  unless get_resp.code.to_i.between?(200, 299)
    UI.user_error!("Remote Config 조회 실패: #{get_resp.code} #{get_resp.body}")
  end
  etag = get_resp["etag"]
  UI.user_error!("Remote Config ETag 를 받지 못했습니다.") if etag.nil? || etag.empty?

  template = JSON.parse(get_resp.body)
  template["parameters"] ||= {}
  template["parameters"]["latest_version_code"] = {
    "defaultValue" => { "value" => version_code.to_s },
    "valueType" => "NUMBER",
  }
  template["parameters"]["latest_version_name"] = {
    "defaultValue" => { "value" => version_name },
    "valueType" => "STRING",
  }

  put = Net::HTTP::Put.new(uri)
  put["Authorization"] = "Bearer #{token}"
  put["Content-Type"] = "application/json; UTF-8"
  put["If-Match"] = etag
  put.body = JSON.generate(template)
  put_resp = http.request(put)
  return if put_resp.code.to_i.between?(200, 299)

  UI.user_error!("Remote Config 게시 실패: #{put_resp.code} #{put_resp.body}")
end
